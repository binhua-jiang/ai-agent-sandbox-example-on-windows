{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": true,
        "filesystem": {
            "denyRead": [
                "./core/src",
                "./core/src/**",
                "./.env"
            ]
        }
    },
    "permissions": {
        "deny": [
            "Read(./core/src)",
            "Read(./core/src/**)",
            "Read(./.env)"
        ]
    }
}
