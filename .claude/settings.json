{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./core/src/**)",
            "Edit(./.env)",
            "Edit(./.env.*)",
            "Edit(./core/src/**)",
            "Edit(./.git/**)",
            "Edit(./.claude/settings.json)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "failIfUnavailable": false,
        "autoAllowBashIfSandboxed": true,
        "allowUnsandboxedCommands": true,
        "enableWeakerNestedSandbox": true,
        "filesystem": {
            "denyRead": [
                "./.env",
                "./.env.*",
                "./core/src/**"
            ],
            "denyWrite": [
                "./.env",
                "./.env.*",
                "./core/src/**",
                "./.git/**",
                "./.claude/settings.json"
            ],
            "allowWrite": [
                "/tmp/claude"
            ]
        },
        "network": {
            "allowedDomains": [
                "api.anthropic.com",
                "*.anthropic.com",
                "docs.anthropic.com",
                "code.claude.com"
            ]
        }
    }
}