# Use one auth method:
# 1) Anthropic-style API key (X-Api-Key)
ANTHROPIC_API_KEY=

# 2) Bearer token auth (Authorization: Bearer ...)
# Leave empty when using ANTHROPIC_API_KEY.
ANTHROPIC_AUTH_TOKEN=you_api_key

# Optional: custom gateway/proxy endpoint (Anthropic-compatible)
# Example: https://llm-gateway.example.com
ANTHROPIC_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic

# Optional: force a model ID/alias
# Example: claude-sonnet-4-6
ANTHROPIC_MODEL=glm-5

# Optional: for GitHub Copilot CLI integration, auto login with a GitHub fine-grained token
COPILOT_GITHUB_TOKEN=your_github_fine_grained_token

# 自定义API网关
COPILOT_PROVIDER_TYPE=openai
COPILOT_PROVIDER_BASE_URL=https://llm-api.fuxinsoft.cn/v1
COPILOT_PROVIDER_API_KEY="your_api_key"
COPILOT_MODEL="glm-5.1"

# === Token 上限（GLM-5.1 规格）===
COPILOT_PROVIDER_MAX_PROMPT_TOKENS="200000"
COPILOT_PROVIDER_MAX_OUTPUT_TOKENS="128000"

# （可选）完全离线模式：阻止 CLI 连 GitHub 服务器
COPILOT_OFFLINE=true